{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://*:5000;https://*:5001",
  "WebSocketConnectionsOptions": {
    "AllowedOrigins": [],
    "SendSegmentSize": 4096,
    "ReceivePayloadBufferSize": 4096
  },
  "GuacOptions": {
    "GuacD": {
      "Host": "127.0.0.1",
      "Port": 4822,
      "SendBufferSize": 4096,
      "SendTimeout": 1000,
      "ReceiveBufferSize": 4096,
      "ReceiveTimeout": 0
    },
    "Cipher": {
      "Type": "AES",
      "Mode": "CBC",
      "BlockSize": 256
    },
    "UserDriveRoot": "/user-drives",
    "AllowedParameters": {
      "Global": [
        "width",
        "height",
        "image",
        "video",
        "audio",
        "protocol_version",
        "dpi"
      ],
      "Connection": {
        "ssh": [
          "color-scheme",
          "font-name",
          "font-size"
        ],
        "telnet": [
          "color-scheme",
          "font-name",
          "font-size"
        ]
      }
    },
    "Timeout": 10000
  }
}