{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.*": "Warning"
    }
  },
  "Server": {
    "ListenOn": "0.0.0.0",
    "HttpPort": 8080,
    "HttpsPort": 8081,
    "LetsEncrypt": {
      "UseHsts": false,
      "UseStagingServer": false,
      "Domains": [],
      "EmailAddress": ""
    },
    "SSL": {
      "CertificatePath": null,
      "CertificatePassword": null
    }
  },
  "WebSocket": {
    "AllowedOrigins": [],
    "UseCompression": true,
    "ReceiveBufferSize": 1024,
    "CloseTimeout": 1500
  },
  "Cipher": {
    "Type": "AES",
    "Mode": "CBC",
    "KeySize": 256
  },
  "Guac": {
    "GuacD": {
      "Host": "127.0.0.1",
      "Port": 4822,
      "SendBufferSize": 1024,
      "SendTimeout": 500,
      "ReceiveBufferSize": 1024,
      "ReceiveTimeout": 0
    },
    "UserDriveRoot": "/user-drives",
    "AllowedParameters": {
      "Global": [
        "width",
        "height",
        "image",
        "video",
        "audio",
        "protocol_version",
        "dpi"
      ],
      "Connection": {
        "ssh": [
          "color-scheme",
          "font-name",
          "font-size"
        ],
        "telnet": [
          "color-scheme",
          "font-name",
          "font-size"
        ]
      }
    },
    "Timeout": 10000
  }
}