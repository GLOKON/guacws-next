{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.*": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080"
      }
    }
  },
  "WebSocket": {
    "AllowedOrigins": [],
    "UseCompression": true,
    "ReceiveBufferSize": 1024,
    "CloseTimeout": 1500
  },
  "Cipher": {
    "Type": "AES",
    "Mode": "CBC",
    "KeySize": 256
  },
  "Guac": {
    "GuacD": {
      "Host": "127.0.0.1",
      "Port": 4822,
      "SendBufferSize": 1024,
      "SendTimeout": 1000,
      "ReceiveBufferSize": 1024,
      "ReceiveTimeout": 0
    },
    "UserDriveRoot": "/user-drives",
    "ProcessingBufferSize": 4096,
    "AllowedParameters": {
      "Global": [
        "width",
        "height",
        "image",
        "video",
        "audio",
        "protocol_version",
        "dpi"
      ],
      "Connection": {
        "ssh": [
          "color-scheme",
          "font-name",
          "font-size"
        ],
        "telnet": [
          "color-scheme",
          "font-name",
          "font-size"
        ]
      }
    },
    "Timeout": 10000
  }
}